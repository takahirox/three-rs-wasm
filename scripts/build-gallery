#!/usr/bin/env bash
# Build the examples gallery into web/pkg/gallery/: every example linked once
# ( gallery/ with its default features ), then split into the primary module and
# a part per module and per chunk of code modules share
# ( tools/gallery/split/build.py ). A page loads the primary module and its
# module's parts ( web/gallery/runtime.js, web/gallery/modules.json ).
#
#   scripts/build-gallery [--dev]
#
# --dev builds the shell alone ( the examples it dispatches itself ),
# unoptimized and unsplit, as the MVP checks use it.
# Splitting needs Binaryen's wasm-split and wasm-opt ( version 127 or later ).
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
OUT="$ROOT/web/pkg/gallery"
python3 "$ROOT/tools/gallery/modules.py"
rm -rf "$ROOT/web/pkg"
if [ "${1:-}" = "--dev" ]; then
  ( cd "$ROOT/gallery" && CARGO_TARGET_DIR="$ROOT/target/gallery-dev" \
    wasm-pack --quiet build --target web --out-dir "$OUT" --out-name three_rs_wasm --dev --no-typescript \
      -- --no-default-features )
  echo '{}' > "$OUT/parts.json"
  exit
fi
# The split reads every reference from the linker's relocations
# ( --emit-relocs ) and every function's owner from its symbol, so LLVM must
# not merge identical functions across modules ( -Zmerge-functions=disabled,
# allowed on the stable compiler through RUSTC_BOOTSTRAP ). wasm-pack also
# installs the wasm-bindgen CLI the split runs.
( cd "$ROOT/gallery" && RUSTC_BOOTSTRAP=1 RUSTFLAGS="-Zmerge-functions=disabled -Clink-arg=--emit-relocs" \
  CARGO_TARGET_DIR="$ROOT/target/gallery" \
  wasm-pack --quiet build --target web --out-dir "$ROOT/target/gallery/pkg" --out-name three_rs_wasm \
    --release --no-opt --no-typescript )
python3 "$ROOT/tools/gallery/split/build.py" \
  "$ROOT/target/gallery/wasm32-unknown-unknown/release/three_rs_gallery.wasm" "$OUT"
