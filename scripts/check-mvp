#!/usr/bin/env bash
set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

PASS=0
FAIL=0
MEMBERS_JSON="${TMPDIR:-/tmp}/three-rs-wasm-members.json"

run() {
  local name="$1"
  shift
  printf '%-36s' "$name"
  if "$@" >/tmp/three-rs-wasm-check.out 2>/tmp/three-rs-wasm-check.err; then
    echo "PASS"
    PASS=$((PASS + 1))
  else
    echo "FAIL"
    FAIL=$((FAIL + 1))
    sed 's/^/    /' /tmp/three-rs-wasm-check.out || true
    sed 's/^/    /' /tmp/three-rs-wasm-check.err || true
  fi
}

require_file() {
  test -f "$1" || { echo "missing required file: $1" >&2; return 1; }
}

run "Frozen manifest files" bash -c 'test -f compat/three-r186/api.json && test -f compat/three-r186/capabilities.json && test -f compat/three-r186/unsupported.json'
run "Generate Core inventory" python3 tools/compat/generate_core_inventory.py --output "$MEMBERS_JSON"
run "Core capability accounting" python3 tools/compat/check_manifest.py --members "$MEMBERS_JSON"
run "Rust workspace" require_file Cargo.toml

if [[ -f Cargo.toml ]]; then
  run "cargo fmt --check" cargo fmt --all -- --check
  run "cargo clippy" cargo clippy --workspace --all-targets --all-features -- -D warnings
  run "cargo test" cargo test --workspace --all-features
  run "Wasm build" cargo build --workspace --target wasm32-unknown-unknown
else
  echo "cargo fmt --check                    FAIL (Cargo.toml missing)"; FAIL=$((FAIL + 1))
  echo "cargo clippy                         FAIL (Cargo.toml missing)"; FAIL=$((FAIL + 1))
  echo "cargo test                           FAIL (Cargo.toml missing)"; FAIL=$((FAIL + 1))
  echo "Wasm build                           FAIL (Cargo.toml missing)"; FAIL=$((FAIL + 1))
fi

run "Behavior compatibility tests" require_file tests/compat/README.md
run "Rust web application suite" require_file examples/manifest.json
run "Migration suite" require_file migration/manifest.json
run "Resource lifecycle tests" require_file tests/resource_lifecycle/README.md
run "Type-safety compile-fail tests" require_file tests/compile_fail/README.md

printf '\nChecks passed: %d\nChecks failed: %d\n' "$PASS" "$FAIL"
if (( FAIL == 0 )); then
  echo "MVP: PASS"
  exit 0
else
  echo "MVP: FAIL"
  exit 1
fi
