#!/usr/bin/env bash
# The three-tsl crate ( three r186's node system transpiled to Rust ) against the
# r186 goldens: every corpus program's WGSL, GLSL, errors and console.
set -euo pipefail
cd "$(dirname "$0")/.."
if command -v rustup >/dev/null 2>&1; then
  TSL_RUSTC="$(rustup which rustc)"
  export PATH="$(dirname "$TSL_RUSTC"):$PATH"
fi
cargo test --locked --manifest-path tsl/Cargo.toml
( cd tsl && wasm-pack build --target nodejs --release --out-dir ../.cache/tsl-node --no-typescript )
node tools/tsl/check.mjs
echo 'TSL node system corpus: PASS'
